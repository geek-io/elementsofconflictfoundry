<section class="eoc-content">
  <header class="eoc-hero"><img class="eoc-portrait" src="{{item.img}}" data-action="editImage" data-edit="img" alt="{{item.name}}"><div class="eoc-heading"><span class="eoc-eyebrow">{{item.type}}</span><input class="eoc-name" name="name" value="{{item.name}}" aria-label="Item name"></div></header>
  {{#if physical}}<div class="eoc-grid"><label>Quantity<input type="number" name="system.quantity" value="{{system.quantity}}" min="0"></label><label>Encumbrance per item<input type="number" name="system.encumbrance" value="{{system.encumbrance}}" min="0" step="any"></label><label>Price<input name="system.price" value="{{system.price}}"></label><label>Category<input name="system.category" value="{{system.category}}"></label><div class="eoc-inline"><label><input type="checkbox" name="system.equipped" {{checked system.equipped}}> Equipped</label><label><input type="checkbox" name="system.carried" {{checked system.carried}}> Carried</label></div></div>{{/if}}
  <details><summary>Targeting template and tags</summary><div class="eoc-grid">    <label>Area template (optional)<select name="system.template">{{selectOptions techniqueTemplates selected=system.template}}</select></label>
    <label>Area length / circle radius (paces; 0 = book default)<input type="number" name="system.areaLength" value="{{system.areaLength}}" min="0" step="any"></label>
    <label>Area width / cone end width (paces; 0 = default)<input type="number" name="system.areaWidth" value="{{system.areaWidth}}" min="0" step="any"></label>
    <label>Cone start width (paces; 0 = default)<input type="number" name="system.areaStartWidth" value="{{system.areaStartWidth}}" min="0" step="any"></label>
<label>Tags (comma separated)<input name="system.tags" value="{{system.tags}}"></label>{{#if weapon}}<label>Weapon style<select name="system.weaponStyle">{{selectOptions weaponStyles selected=system.weaponStyle}}</select></label>{{/if}}</div></details>
  {{#if trait}}<div class="eoc-card"><h2>Trait</h2><label>Trait type<select name="system.audience">{{selectOptions traitAudiences selected=system.audience}}</select></label>{{#if antagonist}}<div class="eoc-grid"><label>Action Point Cost<input type="number" name="system.actionCost" value="{{system.actionCost}}" min="0" max="3" step="1"></label><label>Action Type<select name="system.actionType">{{selectOptions traitActionTypes selected=system.actionType}}</select></label></div><label><input type="checkbox" name="system.spendMisfortune" {{checked system.spendMisfortune}}> Spend Misfortune Points to trigger</label><label>Misfortune cost<input type="number" name="system.misfortuneCost" value="{{system.misfortuneCost}}" min="0"></label><p>Shared Misfortune pool: {{misfortune}}</p>{{/if}}<button type="button" data-action="toggleTrait">{{#if system.active}}Deactivate{{else}}Activate{{/if}}</button><p>Transferring effects apply while this Trait is active.</p></div>{{/if}}
  {{#if profession}}<div class="eoc-card"><h2>Profession Advances <span class="eoc-badge">{{progress.completed}} / 20{{#if progress.complete}} · Complete{{/if}}</span></h2><p>Mark the 3 Talents, 10 Skill Advances, and 7 Bonus Advances as completed.</p>{{#each advanceGroups}}<h3>{{label}}</h3>{{#each slots}}<div class="eoc-advance" data-advance-group="{{../key}}" data-index="{{index}}"><input type="checkbox" name="system.advances.{{../key}}.{{index}}.completed" {{checked completed}} aria-label="Completed advance {{index}}"><input name="system.advances.{{../key}}.{{index}}.name" value="{{name}}" placeholder="{{../placeholder}}" list="{{../../rootId}}-{{../key}}"><input name="system.advances.{{../key}}.{{index}}.uuid" value="{{uuid}}" type="hidden"></div>{{/each}}{{/each}}<datalist id="{{rootId}}-skills">{{#each skills}}<option value="{{label}}">{{/each}}</datalist><datalist id="{{rootId}}-bonuses">{{#each attributes}}<option value="{{this}}">{{/each}}</datalist></div>{{/if}}
  {{#if weapon}}<div class="eoc-card"><h2>Weapon</h2><div class="eoc-grid"><label>Attack skill<select name="system.skill">{{selectOptions skills selected=system.skill valueAttr="key" labelAttr="label"}}</select></label><label>Damage formula<input name="system.damageFormula" value="{{system.damageFormula}}" placeholder="@bonuses.combat + 1d6x6"></label><label>Shield threshold bonus<input type="number" name="system.armorBonus" value="{{system.armorBonus}}" min="0"></label><label>Range<input name="system.range" value="{{system.range}}"></label></div><label>Qualities<input name="system.qualities" value="{{system.qualities}}"></label><div class="eoc-quality-tags">{{#each qualityTags}}<span class="eoc-quality-tag" tabindex="0" data-tooltip-html="{{tooltipHtml}}" data-tooltip-class="eoc-rules-tooltip">{{label}}</span>{{/each}}</div></div>{{/if}}
  {{#if armor}}<label>Damage threshold bonus<input type="number" name="system.armorBonus" value="{{system.armorBonus}}" min="0"></label>{{/if}}
  {{#if skillRecord}}<div class="eoc-card"><h2>Skill</h2><label>Associated test<select name="system.skill">{{selectOptions skills selected=system.skill valueAttr="key" labelAttr="label"}}</select></label><p>Owned Skill records appear alongside the tests on the Skills & Combat page. Set ranks on the character.</p></div>{{/if}}
  {{#if technique}}<div class="eoc-card"><h2>Technique Details</h2><div class="eoc-grid">
    <label>Clone token creation<select name="system.cloneMode">{{selectOptions cloneModes selected=system.cloneMode}}</select></label><label>Clone appearance effect (Sequencer database path or file)<input name="system.cloneEffect" value="{{system.cloneEffect}}" placeholder="Optional JB2A effect path"></label>
    <label>Technique type<select name="system.jutsuType">{{selectOptions techniqueTypes selected=system.jutsuType}}</select></label>
    <label>Technique rank<select name="system.jutsuRank">{{selectOptions jutsuRanks selected=system.jutsuRank}}</select></label>
    <label>Chakra cost<input type="number" name="system.chakraCost" value="{{system.chakraCost}}" min="0" step="1"></label>
    <label>Chakra payment<select name="system.chakraCostMode">{{selectOptions chakraCostModes selected=system.chakraCostMode}}</select></label>
    <label>Action cost (AP)<input type="number" name="system.actionCost" value="{{system.actionCost}}" min="0" max="3" step="1"></label>
    <label>Duration<select name="system.duration">{{selectOptions techniqueDurations selected=system.duration}}</select></label>
    <label>Action type<select name="system.actionType">{{selectOptions techniqueActions selected=system.actionType}}</select></label>
    <label>Range<select name="system.range">{{selectOptions techniqueRanges selected=system.range}}</select></label>
    <label>Element / Chakra nature<input name="system.nature" value="{{system.nature}}"></label>
    <label>Test skill<select name="system.skill">{{selectOptions skills selected=system.skill valueAttr="key" labelAttr="label"}}</select></label>
    <label>Chakra rule / variants<input name="system.chakraCostText" value="{{system.chakraCostText}}"></label>
    <label>Action rule / variants<input name="system.actionCostText" value="{{system.actionCostText}}"></label>
    <label>Duration / upkeep rule<input name="system.durationText" value="{{system.durationText}}"></label>
    <label>Range rule<input name="system.rangeText" value="{{system.rangeText}}"></label>
    <label>Damage formula<input name="system.damageFormula" value="{{system.damageFormula}}"></label>
  </div><label><input type="checkbox" name="system.configured" {{checked system.configured}}> Rules and costs configured for play</label><label><input type="checkbox" name="system.variableCost" {{checked system.variableCost}}> Variable cost or multiple variants</label><p>Use deducts Chakra and AP automatically. Variable-cost Techniques ask for the chosen total.</p></div>{{/if}}
  {{#if technique}}<div class="eoc-card"><h2>Technique Outcomes</h2>{{#each techniqueOutcomes}}<label>{{label}}<textarea name="system.{{key}}" rows="3">{{value}}</textarea></label>{{/each}}</div>{{/if}}
  {{#if profession}}<div class="eoc-card eoc-profession-equipment" data-profession-equipment><div class="eoc-section-title"><h2>Starting Equipment</h2><button type="button" data-action="addEquipment">Add Custom Equipment</button></div><p>Drop Inventory Items here or create custom equipment. These Items are added to Inventory when this Profession is added to an Actor.</p>
  {{#each professionEquipment}}<details data-sync="equipment-{{id}}" class="eoc-equipment-row"><summary>{{name}} · Qty {{system.quantity}}</summary><div class="eoc-grid">
    <label>Name<input data-equipment-field="name" data-index="{{index}}" value="{{name}}"></label>
    <label>Type<select data-equipment-field="type" data-index="{{index}}">{{selectOptions ../equipmentTypes selected=type}}</select></label>
    <label>Quantity<input type="number" min="0" step="1" data-equipment-field="quantity" data-index="{{index}}" value="{{system.quantity}}"></label>
    <label>Encumbrance<input type="number" min="0" step="any" data-equipment-field="encumbrance" data-index="{{index}}" value="{{system.encumbrance}}"></label>
    <label>Price<input data-equipment-field="price" data-index="{{index}}" value="{{system.price}}"></label>
    <label>Attack Skill<select data-equipment-field="skill" data-index="{{index}}">{{selectOptions ../skills selected=system.skill valueAttr="key" labelAttr="label"}}</select></label>
    <label>Damage Formula<input data-equipment-field="damageFormula" data-index="{{index}}" value="{{system.damageFormula}}"></label>
    <label>Armor/Shield Bonus<input type="number" min="0" step="1" data-equipment-field="armorBonus" data-index="{{index}}" value="{{system.armorBonus}}"></label>
    <label>Range<input data-equipment-field="range" data-index="{{index}}" value="{{system.range}}"></label>
    <label>Qualities<input data-equipment-field="qualities" data-index="{{index}}" value="{{system.qualities}}"></label>
  </div><label>Description &amp; Rules<textarea data-equipment-field="description" data-index="{{index}}" rows="4">{{system.description}}</textarea></label><button type="button" data-action="removeEquipment" data-index="{{index}}">Remove Equipment</button></details>{{else}}<p>No starting equipment.</p>{{/each}}</div>{{/if}}
  {{#if weapon}}<label>NPC Test Chance Override (optional)<input type="number" name="system.testChance" value="{{system.testChance}}" min="0" max="200" placeholder="Calculated from skill"></label>{{/if}}
  {{#if technique}}<label>NPC Test Chance Override (optional)<input type="number" name="system.testChance" value="{{system.testChance}}" min="0" max="200" placeholder="Calculated from skill"></label>{{/if}}
  {{#if heritage}}
  <div class="eoc-card"><div class="eoc-section-title"><h2>Heritage Modifiers</h2><button type="button" data-action="addHeritageRow" data-list="modifiers" aria-label="Add modifier"><i class="ra ra-health-increase"></i></button></div>
    <div class="eoc-modifier-header"><span>Modifier</span><span>Value</span><span></span></div>
    {{#each heritageModifiers}}<div class="eoc-modifier-row"><select data-heritage-field="attribute" data-list="modifiers" data-index="{{index}}" aria-label="Modifier {{index}} attribute">{{selectOptions ../heritageModifierOptions selected=attribute}}</select><input type="number" data-heritage-field="value" data-list="modifiers" data-index="{{index}}" value="{{value}}" min="-100" max="100" step="1" aria-label="Modifier {{index}} value"><button type="button" data-action="removeHeritageRow" data-list="modifiers" data-index="{{index}}" aria-label="Remove modifier {{index}}"><i class="ra ra-cancel"></i></button></div>{{else}}<p>No Heritage modifiers.</p>{{/each}}
  </div>
  {{#each heritageBenefits}}<div class="eoc-card"><div class="eoc-section-title"><h2>{{label}}</h2><button type="button" data-action="addHeritageRow" data-list="{{list}}">Add {{singular}}</button></div>
    {{#each rows}}<div class="eoc-heritage-benefit"><div class="eoc-benefit-header"><input data-heritage-field="name" data-list="{{../list}}" data-index="{{index}}" value="{{name}}" aria-label="{{../singular}} name"><select data-heritage-field="tier" data-list="{{../list}}" data-index="{{index}}" aria-label="{{../singular}} tier">{{selectOptions ../../heritageTierOptions selected=tier}}</select><button type="button" data-action="removeHeritageRow" data-list="{{../list}}" data-index="{{index}}" aria-label="Remove {{../singular}} {{name}}"><i class="ra ra-cancel"></i></button></div>{{#unless unlocked}}<small>Available at Tier {{tier}}</small>{{/unless}}<textarea data-heritage-field="description" data-list="{{../list}}" data-index="{{index}}" rows="3" aria-label="{{../singular}} description">{{description}}</textarea></div>{{else}}<p>No {{label}}.</p>{{/each}}
  </div>{{/each}}
  {{/if}}
  <label>Source reference<input name="system.source" value="{{system.source}}"></label>
  <label>Requirements<input name="system.requirements" value="{{system.requirements}}"></label>
  <h2>Description & Rules</h2><div class="eoc-description">{{{enriched}}}</div>
  {{#if editable}}<details><summary>Edit description</summary><prose-mirror name="system.description" data-document-uuid="{{item.uuid}}" value="{{system.description}}" toggled>{{{enriched}}}</prose-mirror></details>{{/if}}
  <div class="eoc-card"><div class="eoc-section-title"><h2>Active Effects</h2><button type="button" data-action="createEffect">Add Effect</button></div>{{#each effects}}<div class="eoc-item-row"><button type="button" class="eoc-item-name" data-action="editEffect" data-uuid="{{uuid}}">{{name}}<small>{{status}} · {{changes}}</small></button><button type="button" data-action="toggleEffect" data-uuid="{{uuid}}">Enable / Disable</button><button type="button" data-action="deleteEffect" data-uuid="{{uuid}}" aria-label="Remove {{name}}"><i class="ra ra-cancel"></i></button></div>{{else}}<p>No effects configured.</p>{{/each}}</div>
  <details><summary>Source data</summary><pre class="eoc-source-data">{{upstream}}</pre></details>
</section>
