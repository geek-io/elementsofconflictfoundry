<div class="eoc-shell eoc-npc-shell">

  <header class="eoc-hero">

    <img class="eoc-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}">

    <div class="eoc-heading"><span class="eoc-eyebrow">ELEMENTS OF CONFLICT · {{#if npc}}ANTAGONIST / NPC{{else}}SHINOBI RECORD{{/if}}</span><input class="eoc-name" name="name" value="{{actor.name}}" aria-label="Character name" placeholder="Character name"><div class="eoc-header-fields"><label>Profession<input name="system.profession" value="{{system.profession}}" placeholder="Choose your path"></label><label>Village<input name="system.village" value="{{system.village}}" placeholder="Home village"></label><label>Tier<input type="number" name="system.tier" value="{{system.tier}}" min="1" max="3"></label></div>{{#if npc}}<label><input type="checkbox" name="system.npcElite" {{checked system.npcElite}}> Elite attribute presets</label>{{/if}}</div>

    <div class="eoc-resource"><label>CHAKRA</label><div><input type="number" name="system.chakra.value" value="{{system.chakra.value}}" min="0" aria-label="Current Chakra"><span>/</span><output aria-label="Maximum Chakra">{{system.chakra.max}}</output></div><label>PLOT ARMOR<input type="number" name="system.shonen" value="{{system.shonen}}" min="0"></label></div>

  </header>

  <div class="eoc-sheet-actions"><button type="button" class="eoc-initiative-roll" data-action="rollInitiative">Roll Initiative</button><button class="eoc-pools-open" type="button" data-action="pools">Fortune &amp; Misfortune</button></div><nav class="eoc-nav tabs" aria-label="Character sections">{{#each tabs}}<button type="button" data-action="tab" data-group="{{group}}" data-tab="{{id}}" class="{{cssClass}}"><i class="{{icon}}" aria-hidden="true"></i> {{localize label}}</button>{{/each}}</nav>

  <div class="eoc-tab-content">

    <section class="tab {{tabs.skills.cssClass}} eoc-overview" data-group="sheet" data-tab="skills">

  <div class="eoc-attributes">{{#each attributes}}<div class="eoc-attribute" data-attribute="{{key}}" {{#if ../npc}}data-tooltip-text="Right-click to cycle attribute values; Shift-right-click cycles backwards."{{/if}}><label for="{{../rootId}}-{{key}}">{{label}}</label><input id="{{../rootId}}-{{key}}" type="number" name="system.attributes.{{key}}" value="{{value}}" min="0" max="100"><span class="eoc-effective">Effective {{effective}}</span><span>Bonus <strong>{{bonus}}</strong></span><label class="eoc-adjust" title="Heritage, advances, and other bonus adjustments">Adjust <input type="number" name="system.bonusAdjustments.{{key}}" value="{{adjustment}}" min="-20" max="20"></label>{{#if ../npc}}<button type="button" data-action="assignAttribute" data-attribute="{{key}}" aria-label="Assign ability to {{label}}">{{#if ability}}{{ability}}{{else}}Assign ability{{/if}}</button>{{#if ability}}<button type="button" data-action="editItem" data-id="{{abilityId}}">Open ability</button>{{/if}}{{/if}}</div>{{/each}}</div>

<div class="eoc-tests-column"><h2>Skills & Tests</h2>      <div class="eoc-skills">{{#each skills}}<div class="eoc-skill" data-associated-attribute="{{attribute}}"><button type="button" class="eoc-roll" data-action="rollSkill" data-skill="{{key}}" title="Roll {{label}}"><span>{{label}}{{#if special}} <small>Special</small>{{/if}}<em>{{attributeLabel}}</em></span></button><label>Ranks<input type="number" name="system.skills.{{key}}" value="{{rank}}" min="0" max="3" aria-label="{{label}} ranks"></label><strong title="Base chance after Peril">{{chance}}%</strong></div>{{/each}}</div><details class="eoc-skill-records" data-sync="skill-records"><summary>Owned Skill Records ({{skillRecords.length}})</summary>{{#each skillRecords}}<div class="eoc-item-row draggable" data-item-id="{{id}}"><img src="{{img}}" alt=""><div class="eoc-item-summary"><span tabindex="0" class="eoc-item-name"  {{#if tooltip}}data-tooltip-html="{{tooltip}}" data-tooltip-class="eoc-rules-tooltip"{{/if}}>{{name}}</span><button type="button" class="eoc-edit-item" data-action="editItem" data-id="{{id}}" aria-label="Edit {{name}}">Edit</button>{{#if qualities}}<div class="eoc-quality-tags">{{#each qualities}}<span class="eoc-quality-tag" tabindex="0" data-tooltip-html="{{tooltipHtml}}" data-tooltip-class="eoc-rules-tooltip">{{label}}</span>{{/each}}</div>{{/if}}</div><button type="button" data-action="deleteItem" data-id="{{id}}" aria-label="Remove {{name}}"><i class="ra ra-cancel"></i></button></div>{{else}}<p>Drop Skill Items here to keep their rules with your tests. Set ranks in the skill list above.</p>{{/each}}</details></div><div class="eoc-combat-column"><div class="eoc-threshold-row"><div class="eoc-threshold damage"><span>Damage Threshold</span><strong>{{stats.damage}}</strong><div>{{#each thresholds}}<span>{{damage}}</span>{{/each}}</div></div><div class="eoc-threshold peril"><span>Peril Threshold</span><strong>{{stats.peril}}</strong><div>{{#each thresholds}}<span>{{peril}}</span>{{/each}}</div></div></div>      <div class="eoc-condition-columns"><div class="eoc-card"><h2>Damage <span class="eoc-badge">{{damageLabel}}</span></h2><div class="eoc-track">{{#each damageStates}}<button type="button" class="{{#if selected}}selected{{/if}}" data-action="setState" data-track="damageState" data-value="{{value}}">{{label}}</button>{{/each}}</div><label><input type="checkbox" name="system.bleeding" {{checked system.bleeding}}> Bleeding</label></div>

      <div class="eoc-card"><h2>Peril <span class="eoc-badge">{{perilLabel}}</span></h2><div class="eoc-track">{{#each perilStates}}<button type="button" class="{{#if selected}}selected{{/if}}" data-action="setState" data-track="perilState" data-value="{{value}}">{{label}}</button>{{/each}}</div></div>

      </div>

<div class="eoc-stat-grid"><div><span>Initiative</span><strong>{{stats.initiative}}</strong><button type="button" data-action="rollInitiative">Roll Initiative</button></div><div><span>Movement</span><strong>{{stats.movement}}</strong></div><div><span>Technique limit</span><strong>{{stats.techniqueLimit}}</strong></div><div><span>Actions remaining</span><input type="number" name="system.actions" value="{{system.actions}}" min="0" max="3"><button type="button" data-action="newRound">New round</button></div></div><div class="eoc-npc-actions"><div class="eoc-card"><h2>Attack profiles</h2>{{#each weapons}}<div class="eoc-item-row"><div class="eoc-item-summary"><span tabindex="0" >{{name}}</span><button type="button" class="eoc-edit-item" data-action="editItem" data-id="{{id}}" aria-label="Edit {{name}}">Edit</button><small>{{system.damageFormula}}  &middot;  {{system.range}}</small></div><button type="button" data-action="rollSkill" data-skill="{{system.skill}}" data-id="{{id}}">Attack</button><button type="button" data-action="rollDamage" data-id="{{id}}">Damage</button></div>{{else}}<p>Drop Weapons from Items or a compendium.</p>{{/each}}</div>{{#if npc}}<div class="eoc-card eoc-combat-traits"><h2>NPC Traits</h2>{{#each npcTraits}}<div class="eoc-item-row draggable" data-item-id="{{id}}"><div class="eoc-item-summary"><span tabindex="0" class="eoc-item-name" data-tooltip-html="{{tooltip}}" data-tooltip-class="eoc-rules-tooltip">{{name}}<small>{{system.actionType}} · {{system.actionCost}} AP{{#if system.spendMisfortune}} · {{system.misfortuneCost}} Misfortune{{/if}}</small></span><button type="button" class="eoc-edit-item" data-action="editItem" data-id="{{id}}">Edit</button></div><button type="button" data-action="toggleTrait" data-id="{{id}}">{{#if system.active}}Deactivate{{else}}Activate{{/if}}</button></div>{{else}}<p>No NPC Traits added.</p>{{/each}}</div>{{/if}}<div class="eoc-section-title"><h2>Techniques</h2><button type="button" data-action="libraryJutsu">Browse Techniques</button></div>{{#each jutsuGroups}}<div class="eoc-card"><h3>{{label}}</h3>{{#each items}}<div class="eoc-item-row draggable" data-item-id="{{id}}"><img src="{{img}}" alt=""><div class="eoc-item-summary"><span tabindex="0" class="eoc-item-name"  {{#if tooltip}}data-tooltip-html="{{tooltip}}" data-tooltip-class="eoc-rules-tooltip"{{/if}}>{{name}}<small>{{system.jutsuRank}} {{system.nature}} · {{system.jutsuType}} · {{#if system.chakraCostText}}{{system.chakraCostText}}{{else}}{{system.chakraCost}}{{/if}} Chakra{{#if draft}} · Draft{{/if}}</small></span><button type="button" class="eoc-edit-item" data-action="editItem" data-id="{{id}}" aria-label="Edit {{name}}">Edit</button>{{#if qualities}}<div class="eoc-quality-tags">{{#each qualities}}<span class="eoc-quality-tag" tabindex="0" data-tooltip-html="{{tooltipHtml}}" data-tooltip-class="eoc-rules-tooltip">{{label}}</span>{{/each}}</div>{{/if}}</div><button type="button" data-action="useTechnique" data-id="{{id}}" {{#if draft}}disabled{{/if}} {{#if reserved}}disabled{{/if}}>Use</button>{{#if reserved}}<button type="button" data-action="endTechnique" data-id="{{id}}">End · {{reserved}} Chakra reserved</button>{{/if}}{{#if hasDamage}}<button type="button" data-action="rollDamage" data-id="{{id}}">Damage</button>{{/if}}<button type="button" data-action="deleteItem" data-id="{{id}}" aria-label="Remove {{name}}"><i class="ra ra-cancel"></i></button></div>{{/each}}</div>{{else}}<div class="eoc-empty"><h3>No Techniques learned</h3><p>Browse the EoC Technique compendiums or create your own technique.</p></div>{{/each}}</div>      

      <div class="eoc-defense-grid"><div class="eoc-card"><h3>Dodge</h3><button type="button" data-action="rollSkill" data-skill="{{dodge.key}}" data-test-label="Dodge" data-associated-attribute="{{dodge.skill.attribute}}">{{dodge.chance}}%</button><select name="system.dodgeSkill">{{selectOptions skills selected=system.dodgeSkill valueAttr="key" labelAttr="label"}}</select></div><div class="eoc-card"><h3>Parry</h3><button type="button" data-action="rollSkill" data-skill="{{parry.key}}" data-test-label="Parry" data-associated-attribute="{{parry.skill.attribute}}">{{parry.chance}}%</button><select name="system.parrySkill">{{selectOptions skills selected=system.parrySkill valueAttr="key" labelAttr="label"}}</select></div></div>

      <details data-sync="secondary-adjustments"><summary>Secondary statistic adjustments</summary><div class="eoc-grid"><label>Initiative<input type="number" name="system.secondaryAdjustments.initiative" value="{{system.secondaryAdjustments.initiative}}"></label><label>Movement<input type="number" name="system.secondaryAdjustments.movement" value="{{system.secondaryAdjustments.movement}}"></label><label>Damage threshold<input type="number" name="system.secondaryAdjustments.damage" value="{{system.secondaryAdjustments.damage}}"></label><label>Peril threshold<input type="number" name="system.secondaryAdjustments.peril" value="{{system.secondaryAdjustments.peril}}"></label><label>Encumbrance limit<input type="number" name="system.secondaryAdjustments.encumbrance" value="{{system.secondaryAdjustments.encumbrance}}"></label><label>Technique limit<input type="number" name="system.secondaryAdjustments.techniqueLimit" value="{{system.secondaryAdjustments.techniqueLimit}}"></label></div></details></div></section>

    <section class="tab {{tabs.jutsu.cssClass}}" data-group="sheet" data-tab="jutsu"><div class="eoc-section-title"><div><h2>Technique</h2><p>All techniques, spells, and rituals. Drop from a compendium or the Items directory.</p></div><div class="eoc-inline"><button type="button" data-action="libraryJutsu">Browse Techniques</button><button type="button" data-action="createItem" data-type="technique">New Technique</button></div></div>{{#each jutsuGroups}}<div class="eoc-card"><h3>{{label}}</h3>{{#each items}}<div class="eoc-item-row draggable" data-item-id="{{id}}"><img src="{{img}}" alt=""><div class="eoc-item-summary"><span tabindex="0" class="eoc-item-name"  {{#if tooltip}}data-tooltip-html="{{tooltip}}" data-tooltip-class="eoc-rules-tooltip"{{/if}}>{{name}}<small>{{system.jutsuRank}} {{system.nature}} · {{system.jutsuType}} · {{#if system.chakraCostText}}{{system.chakraCostText}}{{else}}{{system.chakraCost}}{{/if}} Chakra{{#if draft}} · Draft{{/if}}</small></span><button type="button" class="eoc-edit-item" data-action="editItem" data-id="{{id}}" aria-label="Edit {{name}}">Edit</button>{{#if qualities}}<div class="eoc-quality-tags">{{#each qualities}}<span class="eoc-quality-tag" tabindex="0" data-tooltip-html="{{tooltipHtml}}" data-tooltip-class="eoc-rules-tooltip">{{label}}</span>{{/each}}</div>{{/if}}</div><button type="button" data-action="useTechnique" data-id="{{id}}" {{#if draft}}disabled{{/if}} {{#if reserved}}disabled{{/if}}>Use</button>{{#if reserved}}<button type="button" data-action="endTechnique" data-id="{{id}}">End · {{reserved}} Chakra reserved</button>{{/if}}{{#if hasDamage}}<button type="button" data-action="rollDamage" data-id="{{id}}">Damage</button>{{/if}}<button type="button" data-action="deleteItem" data-id="{{id}}" aria-label="Remove {{name}}"><i class="ra ra-cancel"></i></button></div>{{/each}}</div>{{else}}<div class="eoc-empty"><h3>No Techniques learned</h3><p>Browse the EoC Technique compendiums or create your own technique.</p></div>{{/each}}</section>

    <section class="tab {{tabs.inventory.cssClass}}" data-group="sheet" data-tab="inventory">

      <div class="eoc-section-title"><div><h2>Inventory</h2><p>Carry {{stats.carried}} / {{stats.encumbrance}} · Drop items here or add them from the library.</p></div><div class="eoc-inline"><button type="button" data-action="library"><i class="ra ra-book" aria-hidden="true"></i> Library</button><button type="button" data-action="createItem" data-section="inventory"><i class="ra ra-health-increase" aria-hidden="true"></i> New item</button></div></div>

      {{#each groups}}<div class="eoc-card"><h3>{{label}}</h3>{{#each items}}<div class="eoc-item-row draggable" data-item-id="{{id}}"><img src="{{img}}" alt=""><div class="eoc-item-summary"><span tabindex="0" class="eoc-item-name"  {{#if tooltip}}data-tooltip-html="{{tooltip}}" data-tooltip-class="eoc-rules-tooltip"{{/if}}>{{name}}{{#if physical}}<small>Qty {{system.quantity}} · ENC {{system.encumbrance}}</small>{{/if}}{{#if profession}}<small>{{progress.completed}} / 20 advances{{#if progress.complete}} · Complete{{/if}}</small>{{/if}}</span><button type="button" class="eoc-edit-item" data-action="editItem" data-id="{{id}}" aria-label="Edit {{name}}">Edit</button>{{#if qualities}}<div class="eoc-quality-tags">{{#each qualities}}<span class="eoc-quality-tag" tabindex="0" data-tooltip-html="{{tooltipHtml}}" data-tooltip-class="eoc-rules-tooltip">{{label}}</span>{{/each}}</div>{{/if}}</div>{{#if hasArea}}<button type="button" data-action="targetItem" data-id="{{id}}">Target Area</button>{{/if}}{{#if physical}}<button type="button" data-action="equipItem" data-id="{{id}}" class="{{#if system.equipped}}selected{{/if}}">{{#if system.equipped}}Equipped{{else}}Equip{{/if}}</button>{{/if}}{{#if trait}}<button type="button" data-action="toggleTrait" data-id="{{id}}">{{#if system.active}}Deactivate{{else}}Activate{{#if system.spendMisfortune}} · {{system.misfortuneCost}} Misfortune{{/if}}{{/if}}</button>{{/if}}{{#if identity}}<button type="button" data-action="applyIdentity" data-id="{{id}}">Apply identity</button>{{/if}}{{#if weapon}}<button type="button" data-action="rollSkill" data-skill="{{system.skill}}" data-id="{{id}}">Attack</button><button type="button" data-action="rollDamage" data-id="{{id}}">Damage</button>{{/if}}{{#if technique}}<button type="button" data-action="useTechnique" data-id="{{id}}">Use</button>{{/if}}<button type="button" class="eoc-icon" data-action="deleteItem" data-id="{{id}}" title="Remove {{name}}" aria-label="Remove {{name}}"><i class="ra ra-cancel" aria-hidden="true"></i></button></div>{{/each}}</div>{{else}}<div class="eoc-empty"><i class="ra ra-wooden-sign" aria-hidden="true"></i><h3>Your inventory is empty</h3><p>Open the Library to find equipment, or create your own item.</p><button type="button" data-action="library">Browse Library</button></div>{{/each}}

      <label>Currency<input type="number" name="system.currency" value="{{system.currency}}" min="0"></label>

    </section>

    <section class="tab {{tabs.identity.cssClass}}" data-group="sheet" data-tab="identity">

      <div class="eoc-section-title"><h2>Identity & Background</h2></div><div class="eoc-grid"><label>Heritage<input name="system.heritage" value="{{system.heritage}}"></label><label>Additional Chakra bonus<input type="number" name="system.chakraBonus" value="{{system.chakraBonus}}"></label><label>Chakra nature<input name="system.chakraNature" value="{{system.chakraNature}}"></label><label>Age<input name="system.age" value="{{system.age}}"></label><label>Gender<input name="system.gender" value="{{system.gender}}"></label><label>Experience gained<input type="number" name="system.experience" value="{{system.experience}}" min="0"></label><label>Experience spent<input type="number" name="system.spentExperience" value="{{system.spentExperience}}" min="0"></label></div>{{#if npc}}<div class="eoc-grid"><label>Size<input name="system.npcSize" value="{{system.npcSize}}"></label><label>Threat Rating<input name="system.npcThreatRating" value="{{system.npcThreatRating}}"></label><label>Parry Chance Override<input type="number" name="system.npcDefenses.parry" value="{{system.npcDefenses.parry}}" min="0" max="200" placeholder="Calculated from skill"></label><label>Dodge Chance Override<input type="number" name="system.npcDefenses.dodge" value="{{system.npcDefenses.dodge}}" min="0" max="200" placeholder="Calculated from skill"></label></div>{{/if}}<label>Nindo<input name="system.nindo" value="{{system.nindo}}" placeholder="The way you live"></label><label>Appearance<textarea name="system.appearance" rows="3">{{system.appearance}}</textarea></label><label>Background<textarea name="system.background" rows="7">{{system.background}}</textarea></label><h2>Professions, Heritages, Talents & Traits</h2><button type="button" data-action="createItem" data-section="identity">New Record</button>      {{#each identityGroups}}<div class="eoc-card"><h3>{{label}}</h3>{{#each items}}<div class="eoc-item-row draggable" data-item-id="{{id}}"><img src="{{img}}" alt=""><div class="eoc-item-summary"><span tabindex="0" class="eoc-item-name"  {{#if tooltip}}data-tooltip-html="{{tooltip}}" data-tooltip-class="eoc-rules-tooltip"{{/if}}>{{name}}{{#if physical}}<small>Qty {{system.quantity}} · ENC {{system.encumbrance}}</small>{{/if}}{{#if profession}}<small>{{progress.completed}} / 20 advances{{#if progress.complete}} · Complete{{/if}}</small>{{/if}}</span><button type="button" class="eoc-edit-item" data-action="editItem" data-id="{{id}}" aria-label="Edit {{name}}">Edit</button>{{#if qualities}}<div class="eoc-quality-tags">{{#each qualities}}<span class="eoc-quality-tag" tabindex="0" data-tooltip-html="{{tooltipHtml}}" data-tooltip-class="eoc-rules-tooltip">{{label}}</span>{{/each}}</div>{{/if}}</div>{{#if hasArea}}<button type="button" data-action="targetItem" data-id="{{id}}">Target Area</button>{{/if}}{{#if physical}}<button type="button" data-action="equipItem" data-id="{{id}}" class="{{#if system.equipped}}selected{{/if}}">{{#if system.equipped}}Equipped{{else}}Equip{{/if}}</button>{{/if}}{{#if trait}}<button type="button" data-action="toggleTrait" data-id="{{id}}">{{#if system.active}}Deactivate{{else}}Activate{{#if system.spendMisfortune}} · {{system.misfortuneCost}} Misfortune{{/if}}{{/if}}</button>{{/if}}{{#if heritage}}<button type="button" data-action="activateHeritage" data-id="{{id}}">{{#if selectedHeritage}}Active Heritage{{else}}Set Active Heritage{{/if}}</button>{{/if}}{{#if identity}}<button type="button" data-action="applyIdentity" data-id="{{id}}">Apply identity</button>{{/if}}{{#if weapon}}<button type="button" data-action="rollSkill" data-skill="{{system.skill}}" data-id="{{id}}">Attack</button><button type="button" data-action="rollDamage" data-id="{{id}}">Damage</button>{{/if}}{{#if technique}}<button type="button" data-action="useTechnique" data-id="{{id}}">Use</button>{{/if}}<button type="button" class="eoc-icon" data-action="deleteItem" data-id="{{id}}" title="Remove {{name}}" aria-label="Remove {{name}}"><i class="ra ra-cancel" aria-hidden="true"></i></button></div>{{/each}}</div>{{else}}<p>No identity or ability records added.</p>{{/each}}



    </section>

    <section class="tab {{tabs.effects.cssClass}}" data-group="sheet" data-tab="effects"><div class="eoc-section-title"><h2>Active Effects</h2><button type="button" data-action="createEffect">Add Effect</button></div><p>Misfortune pool: {{misfortune}} · Open Fortune &amp; Misfortune to spend or reset shared coins.</p>{{#each effects}}<div class="eoc-item-row"><img src="{{img}}" alt=""><button type="button" class="eoc-item-name" data-action="editEffect" data-uuid="{{uuid}}">{{name}}<small>{{source}} · {{status}} · {{changes}}</small></button><button type="button" data-action="toggleEffect" data-uuid="{{uuid}}">Enable / Disable</button><button type="button" data-action="deleteEffect" data-uuid="{{uuid}}" aria-label="Remove {{name}}"><i class="ra ra-cancel"></i></button></div>{{else}}<p>No Active Effects. Add an effect here, or configure transferring effects on an owned Item.</p>{{/each}}</section>

    <section class="tab {{tabs.notes.cssClass}}" data-group="sheet" data-tab="notes"><h2>Notes & Journal</h2><textarea class="eoc-journal" name="system.notes" rows="16" placeholder="People, places, goals, and session notes…">{{system.notes}}</textarea></section>

  </div>

</div>

