<section class="eoc-content"><div class="eoc-section-title"><div><h2>EoC Compendium Browser</h2><p>{{#if actorName}}Add entries to {{actorName}}, or{{else}}Open an entry to view its rules, or{{/if}} drag it onto a character sheet or the Items directory.</p></div><span class="eoc-badge">{{total}} matches</span></div><div class="eoc-library-filters"><input type="search" name="search" value="{{query}}" placeholder="Search names, categories, tags, or sources…" aria-label="Search library"><select name="category" aria-label="Item category"><option value="">All item types</option>{{selectOptions categories selected=category}}</select></div><div class="eoc-grid eoc-library-facets">{{#each facets}}<label>{{label}}<select data-facet="{{key}}"><option value="">All</option>{{selectOptions choices selected=selected valueAttr="value" labelAttr="label"}}</select></label>{{/each}}</div><p class="eoc-muted">Showing up to 100 matches. Refine your search to find more.</p><div class="eoc-library-results">{{#each records}}<div class="eoc-item-row" data-drag-uuid="{{uuid}}"><img src="{{img}}" alt=""><button type="button" class="eoc-item-name" data-action="view" data-uuid="{{uuid}}" {{#if tooltip}}data-tooltip-html="{{tooltip}}" data-tooltip-class="eoc-rules-tooltip"{{/if}}>{{name}}<small>{{type}} · {{source}}{{#if system.nature}} · {{system.nature}} {{system.jutsuRank}}{{/if}}{{#if system.contentStatus}} · {{system.contentStatus}}{{/if}}</small></button>{{#if ../editable}}<button type="button" data-action="add" data-uuid="{{uuid}}"><i class="ra ra-health-increase" aria-hidden="true"></i> Add</button>{{/if}}</div>{{else}}<div class="eoc-empty">No matching entries.</div>{{/each}}</div></section>
