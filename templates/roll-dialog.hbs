<div class="eoc-test-summary"><strong data-test-chance>{{start.chance}}%</strong><span>{{start.skill.label}} · {{attribute}}<small>{{start.effectiveRank}} effective / {{start.rank}} learned ranks</small></span></div>
{{#if technique}}<fieldset class="eoc-technique-costs"><legend>Technique Costs</legend><label>Chakra<input type="number" name="chakra" min="0" step="1" value="{{technique.system.chakraCost}}" {{#unless technique.system.variableCost}}readonly{{/unless}}></label><label>AP<input type="number" name="actions" min="0" max="3" step="1" value="{{technique.system.actionCost}}" {{#unless technique.system.variableCost}}readonly{{/unless}}></label>{{#if technique.system.variableCost}}<p>{{technique.system.chakraCostText}} Chakra · {{technique.system.actionCostText}} AP. Enter the totals for this use.</p>{{/if}}{{#if passive}}<p>Activates this Technique without a Skill Test.</p>{{/if}}</fieldset>{{/if}}
{{#if technique}}<p class="eoc-resource-summary">Available: {{resources.chakra}} / {{resources.max}} Chakra{{#if combatAP}} · {{resources.actions}} AP remaining{{else}} · Outside combat: no AP required or spent{{/if}}.</p>{{/if}}
{{#if weapon}}<p>{{#if combatAP}}Weapon attacks spend 1 AP when you confirm this test. {{resources.actions}} AP remaining.{{else}}Outside combat: no AP required or spent.{{/if}}</p>{{/if}}
<div class="eoc-dialog-columns"><fieldset><legend>Test Configuration</legend><label>Base chance modifier<input name="modifier" type="number" value="0" step="1"></label><label>Difficulty rating<select name="difficulty">{{selectOptions difficulties selected=0 labelAttr="label" valueAttr="value"}}</select></label><label>Flip to succeed / fail<select name="mode"><option value="normal">Normal</option><option value="advantage">Advantage · best digits</option><option value="disadvantage">Disadvantage · worst digits</option></select></label><label>Test visibility<select name="visibility">{{selectOptions visibility selected=currentVisibility labelAttr="label" valueAttr="id"}}</select></label>{{#if start.disadvantaged}}<p>Untrained Special skill: disadvantage applies. Advantage cancels it.</p>{{/if}}</fieldset><fieldset><legend>Talents &amp; Traits</legend><p>Review your abilities, then enter any applicable modifier.</p>{{#each abilities}}<details><summary>{{name}}</summary><div>{{description}}</div></details>{{else}}<p>No Talents or Traits added.</p>{{/each}}</fieldset></div>
<fieldset class="eoc-dialog-effects"><legend>Active Effects</legend><p>Enable or disable existing effects here. Changes remain in effect after this roll.</p>{{#each effects}}<label><input type="checkbox" data-effect-uuid="{{uuid}}" {{checked enabled}} {{#if readonly}}disabled{{/if}}><span>{{name}}{{#if suppressed}} · Suppressed{{/if}}<small>{{changes}}</small></span></label>{{else}}<p>No Active Effects on this Actor.</p>{{/each}}</fieldset>
